# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nlp_sql_agent_db
DB_USER=nlp_agent_readonly
DB_PASSWORD=

# --- LLM Provider ---
LLM_PROVIDER=openrouter          # openrouter | gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                # e.g. a current free model id from openrouter.ai/models
GEMINI_API_KEY=

# --- Agent behavior ---
MAX_ROW_LIMIT=200
QUERY_TIMEOUT_SECONDS=10
MAX_LLM_RETRIES=2
